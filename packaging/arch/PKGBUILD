# Maintainer: HttpPilot contributors
# Local developer preview for Arch Linux / Omarchy.
pkgname=httppilot
pkgver=0.1.0
pkgrel=1
pkgdesc='Native Rust HTTP API client with optional AI integrations'
arch=('x86_64')
url='https://github.com/tiagosouzaf/httppilot'
license=('unknown')
depends=('glibc' 'gcc-libs' 'libxkbcommon' 'wayland' 'libx11' 'libglvnd' 'sqlite' 'dbus')
optdepends=(
  'zenity: file picker support'
  'kdialog: KDE file picker support'
  'libsecret: integration with a Secret Service keyring'
)
makedepends=('rust' 'cargo' 'pkgconf' 'cmake' 'ninja')
options=('!debug')
source=()
sha256sums=()

build() {
    cd "$startdir"
    # Rust's default LLD linker on current Linux targets can omit native
    # static archives (including AWS-LC). Use GNU BFD for this package.
    # The AWS-LC CMake builder includes the full crypto native object set.
    AWS_LC_SYS_CMAKE_BUILDER=1 \
      LIBSQLITE3_SYS_USE_PKG_CONFIG=1 \
      RUSTFLAGS="-C link-arg=-fuse-ld=bfd -C link-arg=-lsqlite3 -C link-arg=-ldbus-1" \
      CARGO_TARGET_DIR="$startdir/target" \
      cargo build --locked --release \
        -p httppilot-desktop \
        -p httppilot-cli
}

package() {
    install -Dm755 "$startdir/target/release/httppilot-desktop" \
      "$pkgdir/usr/bin/httppilot"
    install -Dm755 "$startdir/target/release/httppilot-cli" \
      "$pkgdir/usr/bin/httppilot-cli"
    install -Dm644 "$startdir/packaging/linux/httppilot.desktop" \
      "$pkgdir/usr/share/applications/httppilot.desktop"
}
